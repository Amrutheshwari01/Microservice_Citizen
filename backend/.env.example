# AgriLink – Citizen Identity & Wallet Microservice
# Copy this file to .env and fill in all values.
# Never commit the actual .env file to source control.

# ── Database ─────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string (Session or Transaction Pooler)
# Format: postgresql+psycopg://<user>:<password>@<host>:5432/<db>
DATABASE_URL=postgresql+psycopg://postgres.xxxx:PASSWORD@aws-0-xx-west-1.pooler.supabase.com:5432/postgres

# ── Supabase Storage ─────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_STORAGE_BUCKET_KYC=kyc-documents
SUPABASE_STORAGE_BUCKET_AVATARS=avatars

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false

# ── JWT Authentication ────────────────────────────────────────────────────────
# Minimum 32 random characters – generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-secure-random-secret-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── OTP & Login Security ──────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ── Inter-Microservice Service Secret ────────────────────────────────────────
# Used by AgriLink Marketplace and RTO Microservice via X-Service-Key header
INTERNAL_SERVICE_SECRET=replace-with-a-secure-internal-service-secret

# ── CORS Origins (comma-separated JSON list) ──────────────────────────────────
# Development: React Vite frontend
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── Database Pool Settings ────────────────────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Hugging Face AI & Biometrics
# Optional: Hugging Face user access token for cloud vision feature extraction
# If not provided, a robust local perceptual feature extractor is used automatically.
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=google/vit-base-patch16-224
FACE_MATCH_THRESHOLD=0.78

# ─── Twilio SMS OTP Gateway ───────────────────────────────────────────────────
# Real SMS carrier delivery for OTP verification
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
