# Copy to .env and fill in local/dev values. Never commit .env.

# SQLAlchemy URL for Supabase Postgres (psycopg v3 driver)
# Example: postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=

# App
APP_NAME=Citizen Identity & Wallet API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# JWT — generate a long random secret locally
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Service-to-service (Phase 10)
INTERNAL_SERVICE_TOKEN=change-me

# Supabase Storage (Phase 6)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KYC_BUCKET=kyc-documents
